# CollabCircle links. Include the full https:// URL for each value.
Website=https://example.com
Facebook=https://facebook.com/example
Instagram=https://instagram.com/example
Linkedin=https://linkedin.com/company/example
X=https://x.com/example
YouTube=https://youtube.com/@example

# Required for consistent production rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client-IP header written by your trusted reverse proxy. Vercel is auto-detected.
TRUSTED_IP_HEADER=

# Local production-like runs only; never enable for a multi-instance public deployment.
ALLOW_IN_MEMORY_RATE_LIMIT=false

# Canonical public URL used by metadata, robots, and sitemap generation.
SITE_URL=https://shieldcircle.example
